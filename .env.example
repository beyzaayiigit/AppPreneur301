# Lumeris — ortam değişkenleri (referans)
#
# Bu dosya repo kökünde özet şablondur. Çalıştırma için kopyalayın:
#   backend/.env   ← [BACKEND] bölümü
#   frontend/.env  ← [FRONTEND] bölümü
#
# Asla .env dosyalarını commit etmeyin. GEMINI_API_KEY gizli kalmalı.

# =============================================================================
# [BACKEND]  →  backend/.env
# Yerel: cd backend && py -m uv run uvicorn app.main:app --reload --port 3001
# Canlı: Render Environment paneli (backend/.env dosyasına kopyalamayın)
# =============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SEC=45

HOST=0.0.0.0
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Render (canlı) — panelde ayarlayın:
# PUBLIC_BASE_URL=https://lumeris-api.onrender.com
# CORS_ALLOW_ORIGINS=*

# =============================================================================
# [FRONTEND]  →  frontend/.env
# Expo / APK build sırasında okunur (EXPO_PUBLIC_* uygulamaya gömülür)
# =============================================================================

# Canlı backend (Render) — fiziksel cihaz, Expo Go, release APK:
EXPO_PUBLIC_LUMERIS_API_BASE_URL=https://lumeris-api.onrender.com

# Yerel geliştirme — yukarı satırı yorum yapın, birini seçin:
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://192.168.1.102:3001
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://10.0.2.2:3001
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://127.0.0.1:3001
