# Lumeris Backend — copy to .env and fill in values (never commit .env)

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
# Virgülle ayrılmış yedek modeller (503 yoğunlukta otomatik denenir)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SEC=45

# Server
HOST=0.0.0.0
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001

# Comma-separated origins for Expo web / Vercel (use * for local dev only)
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
