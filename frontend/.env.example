# Physical phone + Expo Go (same Wi‑Fi as PC) — use PC LAN IP from `npx expo start`:
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://192.168.1.102:3001
#
# Android Emulator (Android Studio) — host loopback alias:
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://10.0.2.2:3001
#
# USB debugging — after: adb reverse tcp:3001 tcp:3001
# EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://127.0.0.1:3001
#
EXPO_PUBLIC_LUMERIS_API_BASE_URL=http://192.168.1.102:3001
