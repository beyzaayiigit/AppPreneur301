{
  "expo": {
    "name": "Lumeris",
    "slug": "lumeris",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6E6FA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Lumeris, fotoğraflarınızı düzenlemek için galeri erişimine ihtiyaç duyar.",
        "NSPhotoLibraryAddUsageDescription": "Lumeris, düzenlenen fotoğrafı kaydetmek için galeriye yazma iznine ihtiyaç duyar."
      }
    },
    "android": {
      "package": "com.lumeris.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6E6FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "lumerisApiBaseUrl": "http://127.0.0.1:3001"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumeris, fotoğraflarınızı düzenlemek için galeri erişimine ihtiyaç duyar."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lumeris, son fotoğraflarınızı önizlemek ve düzenlemek için galeri erişimine ihtiyaç duyar.",
          "savePhotosPermission": "Lumeris, düzenlenen fotoğrafı kaydetmek için galeriye yazma iznine ihtiyaç duyar.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-font"
    ]
  }
}
